# Copy to .env and fill credentials locally. Never commit real keys.
# The container launcher mounts this host directory at /models.
LOYAL_MODEL_ROOT=/path/to/models
# Keep this pinned to the image matched by slime/docker/version.txt at v0.2.0.
LOYAL_SLIME_IMAGE=slimerl/slime:nightly-dev-202511127a
# MIU uses six GPUs: two TP=1 actor ranks form DP=2 and four independent TP=1
# SGLang engines generate rollouts. Replace the device list for your allocation.
LOYAL_MIU_GPU_DEVICES=0,1,2,3,4,6
LOYAL_MIU_TRAIN_GPU_COUNT=2
LOYAL_MIU_ROLLOUT_GPU_COUNT=4
LOYAL_MIU_RAY_NUM_GPUS=6
LOYAL_MIU_SGLANG_MEM_FRACTION_STATIC=0.80
LOYAL_MIU_SGLANG_SERVER_CONCURRENCY=128
LOYAL_MIU_ROLLOUT_BATCH_SIZE=64
LOYAL_MIU_SAMPLES_PER_PROMPT=8
LOYAL_MIU_GLOBAL_BATCH_SIZE=512
LOYAL_MIU_MAX_RESPONSE_LEN=1024
LOYAL_MIU_MAX_TOKENS_PER_GPU=4096
LOYAL_MIU_SAVE_INTERVAL=1
# Four groups x eight candidates produce at most 32 concurrent requests to
# each logical judge, matching the per-role client caps.
LOYAL_MIU_GROUP_RM_MAX_CONCURRENT=4
LOYAL_MIU_DECISION_JUDGE_MAX_CONCURRENT=32
LOYAL_MIU_FAITHFULNESS_JUDGE_MAX_CONCURRENT=32
# EIL reserves host GPUs 0,1 for the existing 35B vLLM adversary; Ray sees
# physical GPUs 2-7, which are renumbered to 0-5 inside the training container.
LOYAL_EIL_TRAIN_GPU_COUNT=2
LOYAL_EIL_ROLLOUT_GPU_COUNT=4
LOYAL_EIL_RAY_NUM_GPUS=6
LOYAL_EIL_ADVERSARY_GPU_COUNT=2
LOYAL_EIL_TRAIN_GPU_DEVICES=2,3,4,5,6,7
LOYAL_EIL_ADVERSARY_GPU_DEVICES=0,1
# Both task launchers use actor tensor parallelism TP=1. With two actor GPUs,
# the resulting actor data parallel degree is DP=2.
# Applied to every EIL rollout GPU. 0.28 leaves about 40 GiB free on an 80 GiB
# GPU that already has a 17 GiB external workload.
LOYAL_EIL_SGLANG_MEM_FRACTION_STATIC=0.28
# Qwen's EIL replies normally finish well below this; capped completions with
# an unfinished thinking block are excluded from reward and GRPO updates.
LOYAL_EIL_MAX_RESPONSE_LEN=1024
LOYAL_EIL_ADVERSARY_API_KEYS=
LOYAL_EIL_ADVERSARY_BASE_URL=
LOYAL_EIL_ADVERSARY_MODEL=qwen3.5-35b-a3b
LOYAL_EIL_JUDGE_BASE_URL=
LOYAL_EIL_JUDGE_MODEL=gpt-5.4
LOYAL_MIU_JUDGE_BASE_URL=
LOYAL_MIU_JUDGE_MODEL=gpt-5.4
# Each logical judge inherits its task-level endpoint/model above. Set one only
# to use a different model for that role. The four roles are EIL leakage,
# EIL task utility, MIU decision alignment, and MIU reasoning faithfulness.
LOYAL_EIL_LEAKAGE_JUDGE_MODEL=
LOYAL_EIL_UTILITY_JUDGE_MODEL=
LOYAL_MIU_DECISION_JUDGE_MODEL=
LOYAL_MIU_FAITHFULNESS_JUDGE_MODEL=
# One credential is shared by every logical judge role.
LOYAL_JUDGE_API_KEY=
LOYAL_JUDGE_BASE_URL=
